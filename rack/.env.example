# ============================================================
# rack — Konfiguration
# ============================================================
# Kopieren nach .env, ausfüllen, Rechte auf 600 setzen:
#   cp .env.example .env && chmod 600 .env
# Die .env gehört NICHT ins Repository (steht in .gitignore).
# ============================================================

# Anthropic-Schlüssel. Beginnt mit sk-ant-.
# Aus der Anthropic Console unter Settings -> API Keys; Guthaben wird
# vorab unter Settings -> Billing gekauft, ein Ausgabenlimit ist
# empfohlen. Ein Claude-Pro-Abo enthält KEINEN API-Zugang.
# Leer lassen ist erlaubt: der Container startet, die Regel-Engine und
# alle Ansichten funktionieren, nur Fotos lesen und Kuratieren fallen aus.
# Ein Wechsel wirkt nach `docker compose restart rack`, ohne Neubau.
ANTHROPIC_API_KEY=

# Modelle. Beides Sonnet 5: deutlich günstiger als Opus und für diese
# Aufgaben ausreichend. Wer beim Kuratieren mehr Urteilsvermögen möchte,
# kann RACK_MODEL_CURATE auf claude-opus-5 setzen. Das kostet spürbar
# mehr, betrifft aber nur die wenigen Aufrufe für Outfits und Lücken.
RACK_MODEL_VISION=claude-sonnet-5
RACK_MODEL_CURATE=claude-sonnet-5

# Token-Schutz vor der API. Über Tailscale nicht nötig und deshalb leer.
# Nur setzen, falls der Port doch einmal im LAN geöffnet wird.
RACK_TOKEN=

# Host-Port. Gebunden an 127.0.0.1, nach außen geht nur tailscale serve.
RACK_PORT=8099

# An die übrigen Unraid-Container angeglichen.
PUID=99
PGID=100
UMASK=022
TZ=Europe/Berlin

# Wohin die Volumes zeigen.
APPDATA=/mnt/user/appdata

# Feineinstellungen
RACK_TREND_MAX_AGE_DAYS=30
RACK_MAX_IMAGE_DIM=1000
RACK_CUTOUT=1

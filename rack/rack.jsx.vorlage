import React, { useState, useEffect, useRef } from "react";

/* ═══════════════════════════════════════════════════════════════════
   RACK
   1 Erfassen    Foto, Freistellung, Modell liest nur sichtbare Fakten
   2 Rechnen     harte Ausschlüsse, dann gewichtete Bewertung
   3 Kuratieren  Modell wählt aus, benennt, erklärt das Tragen
   4 Lücken      Waisenanalyse und virtueller Test neuer Teile
   Speicher läuft ausschließlich über store(), damit der spätere
   Umzug auf einen eigenen Server nur diese Schicht betrifft.
   ═══════════════════════════════════════════════════════════════════ */

const C = {
  bg: "#121212",
  surface: "#1a1a1a",
  raised: "#232323",
  line: "#2f2f2f",
  text: "#ece8e2",
  dim: "#8f8981",
  faint: "#5c5852",
  signal: "#c8542f",
};
const DISPLAY = "'Bodoni Moda', Didot, Georgia, serif";
const SANS = "'Archivo', 'Helvetica Neue', Arial, sans-serif";

const CATEGORIES = ["Oberteil", "Unterteil", "Kleid", "Jacke", "Schuhe", "Accessoire"];
const ACCESSORY_TYPES = ["Uhr", "Schmuck", "Mütze", "Cap", "Schal", "Gürtel", "Tasche", "Brille"];
const HEAD_WARM = ["Mütze", "Schal"];
const FITS = ["oversize", "weit", "regular", "slim", "cropped"];
const TOP_LEN = ["cropped", "hüftlang", "longline"];
const BOTTOM_LEN = ["shorts", "sieben-achtel", "knöchel", "lang", "stacked"];
const RISES = ["high", "mid", "low"];
const THICKNESS = ["dünn", "mittel", "dick"];
const PATTERNS = ["uni", "gestreift", "kariert", "gemustert", "meliert", "logo"];
const SHOE_WEIGHT = ["filigran", "normal", "chunky"];
const BUILDS = ["schlank", "normal", "athletisch", "kräftig"];
const TORSOS = ["langer Oberkörper", "ausgeglichen", "lange Beine"];
const SILHOUETTES = [
  { key: "oversize", label: "Durchgehend weit", hint: "Enge Teile fallen raus" },
  { key: "mix", label: "Oben weit, unten gerade", hint: "Volumen oben, klare Linie unten" },
  { key: "frei", label: "Proportionsspiel", hint: "Weit zu schmal ist erwünscht" },
  { key: "offen", label: "Alles erlaubt", hint: "Keine Silhouettenvorgabe, nur Statur und Proportion entscheiden" },
];
const OCCASIONS = [
  { key: "Alltag", f: 2 },
  { key: "Arbeit", f: 4 },
  { key: "Abends", f: 3 },
  { key: "Anlass", f: 5 },
  { key: "Sport", f: 1 },
];

const META = "rack_meta";
const TRENDS = "rack_trends";
const ALBUM = 10;
const TREND_MAX_AGE = 30 * 86400000;

/* ───────────────────────────── Speicheradapter ───────────────────── */

/* Die Aufrufform der Speicher-API unterscheidet sich je nach Umgebung.
   Beim ersten Zugriff probiert die App die Varianten durch und merkt sich
   die funktionierende. Klappt keine, läuft alles nur in dieser Sitzung. */
const VARIANTS = [
  { id: "text, geteilt-Flag", set: (k, v) => window.storage.set(k, JSON.stringify(v), false), get: (k) => window.storage.get(k, false) },
  { id: "text", set: (k, v) => window.storage.set(k, JSON.stringify(v)), get: (k) => window.storage.get(k) },
  { id: "objekt, geteilt-Flag", set: (k, v) => window.storage.set(k, v, false), get: (k) => window.storage.get(k, false) },
  { id: "objekt", set: (k, v) => window.storage.set(k, v), get: (k) => window.storage.get(k) },
];
let MODE = null;

function unpack(r) {
  if (r === null || r === undefined) return null;
  const v = r && typeof r === "object" && "value" in r ? r.value : r;
  if (v === null || v === undefined) return null;
  return typeof v === "string" ? JSON.parse(v) : v;
}

async function diagnose() {
  const out = [];
  const add = (label, info) => out.push({ label, info: String(info).slice(0, 260) });
  if (!window.storage) return [{ label: "window.storage", info: "nicht vorhanden" }];
  add("Methoden", Object.keys(window.storage).join(", ") || "keine");

  /* Lesen zuerst. Klappt das, ist die Gegenseite grundsätzlich erreichbar. */
  try {
    add("list()", JSON.stringify(await window.storage.list()));
  } catch (e) {
    add("list()", `Fehler: ${e.message}`);
  }
  try {
    add('list("", false)', JSON.stringify(await window.storage.list("", false)));
  } catch (e) {
    add('list("", false)', `Fehler: ${e.message}`);
  }
  try {
    add("get unbekannt", JSON.stringify(await window.storage.get("rack_nope", false)));
  } catch (e) {
    add("get unbekannt", `Fehler: ${e.message}`);
  }

  /* Dann schreiben, mit immer einfacheren Werten. */
  const values = [
    ["nur ein Zeichen", "x"],
    ["Zahl als Text", "1"],
    ["JSON-Text", '{"t":1}'],
    ["leerer Text", ""],
  ];
  for (const [name, val] of values) {
    try {
      const r = await window.storage.set("rack_probe", val, false);
      add(`set ${name}`, `ok, Rückgabe ${JSON.stringify(r)}`);
    } catch (e) {
      add(`set ${name}`, `Fehler: ${e.message}`);
    }
  }
  try {
    add("delete", JSON.stringify(await window.storage.delete("rack_probe", false)));
  } catch (e) {
    add("delete", `Fehler: ${e.message}`);
  }
  return out;
}

const store = {
  get mode() {
    return MODE ? MODE.id : null;
  },
  async get(key) {
    const list = MODE ? [MODE, ...VARIANTS.filter((v) => v !== MODE)] : VARIANTS;
    for (const v of list) {
      try {
        const r = await v.get(key);
        if (r !== undefined) return unpack(r);
      } catch (e) {
        /* nächste Variante */
      }
    }
    return null;
  },
  async set(key, value) {
    if (!window.storage) throw new Error("Kein Speicher in dieser Umgebung");
    const list = MODE ? [MODE, ...VARIANTS.filter((v) => v !== MODE)] : VARIANTS;
    let last = null;
    for (const v of list) {
      try {
        await v.set(key, value);
        const check = await v.get(key);
        if (unpack(check) !== null) {
          MODE = v;
          return true;
        }
      } catch (e) {
        last = e;
      }
    }
    throw last || new Error("Keine Speichervariante hat funktioniert");
  },
};

/* ────────────────────────────── Bildhandwerk ─────────────────────── */

const loadImage = (src) =>
  new Promise((res, rej) => {
    const i = new Image();
    i.onload = () => res(i);
    i.onerror = () => rej(new Error("bild"));
    i.src = src;
  });

const readFile = (file) =>
  new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result);
    r.onerror = () => rej(new Error("datei"));
    r.readAsDataURL(file);
  });

function tryCutout(canvas) {
  const ctx = canvas.getContext("2d", { willReadFrequently: true });
  const w = canvas.width;
  const h = canvas.height;
  const img = ctx.getImageData(0, 0, w, h);
  const d = img.data;

  const border = [];
  for (let x = 0; x < w; x += 3) border.push(x, (h - 1) * w + x);
  for (let y = 0; y < h; y += 3) border.push(y * w, y * w + w - 1);

  let r = 0, g = 0, b = 0;
  border.forEach((p) => {
    r += d[p * 4];
    g += d[p * 4 + 1];
    b += d[p * 4 + 2];
  });
  r /= border.length;
  g /= border.length;
  b /= border.length;

  let variance = 0;
  border.forEach((p) => {
    variance += Math.abs(d[p * 4] - r) + Math.abs(d[p * 4 + 1] - g) + Math.abs(d[p * 4 + 2] - b);
  });
  if (variance / border.length > 46) return null;

  const visited = new Uint8Array(w * h);
  const stack = border.slice();
  while (stack.length) {
    const p = stack.pop();
    if (p < 0 || p >= w * h || visited[p]) continue;
    const o = p * 4;
    if (Math.sqrt((d[o] - r) ** 2 + (d[o + 1] - g) ** 2 + (d[o + 2] - b) ** 2) > 58) continue;
    visited[p] = 1;
    d[o + 3] = 0;
    const x = p % w;
    if (x > 0) stack.push(p - 1);
    if (x < w - 1) stack.push(p + 1);
    stack.push(p - w, p + w);
  }

  let cleared = 0;
  for (let i = 0; i < w * h; i++) if (visited[i]) cleared++;
  const ratio = cleared / (w * h);
  if (ratio < 0.08 || ratio > 0.93) return null;
  ctx.putImageData(img, 0, 0);

  let minX = w, minY = h, maxX = 0, maxY = 0;
  for (let y = 0; y < h; y++)
    for (let x = 0; x < w; x++)
      if (d[(y * w + x) * 4 + 3] > 24) {
        if (x < minX) minX = x;
        if (x > maxX) maxX = x;
        if (y < minY) minY = y;
        if (y > maxY) maxY = y;
      }
  if (maxX <= minX || maxY <= minY) return null;

  const bw = maxX - minX;
  const bh = maxY - minY;
  const side = Math.round(Math.max(bw, bh) * 1.14);
  const out = document.createElement("canvas");
  out.width = side;
  out.height = side;
  out.getContext("2d").drawImage(canvas, minX, minY, bw, bh, (side - bw) / 2, (side - bh) / 2, bw, bh);
  return out.toDataURL("image/png");
}

async function prepareImage(file, cutoutOn, maxDim = 460) {
  const img = await loadImage(await readFile(file));
  const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
  const c = document.createElement("canvas");
  c.width = Math.round(img.width * scale);
  c.height = Math.round(img.height * scale);
  c.getContext("2d", { willReadFrequently: true }).drawImage(img, 0, 0, c.width, c.height);
  if (cutoutOn) {
    try {
      const cut = tryCutout(c);
      if (cut) return { url: cut, cutout: true };
    } catch (e) {
      /* Freistellung ist optional */
    }
  }
  const flat = document.createElement("canvas");
  flat.width = c.width;
  flat.height = c.height;
  const f = flat.getContext("2d");
  f.fillStyle = "#f2f0ed";
  f.fillRect(0, 0, flat.width, flat.height);
  f.drawImage(c, 0, 0);
  return { url: flat.toDataURL("image/jpeg", 0.74), cutout: false };
}

/* ─────────────────────── Farbe und abgeleitete Werte ─────────────── */

function hsl(hex) {
  if (!hex || typeof hex !== "string") return { h: 0, s: 0, l: 0.5 };
  const m = hex.replace("#", "").match(/.{1,2}/g);
  if (!m || m.length < 3) return { h: 0, s: 0, l: 0.5 };
  const [r, g, b] = m.map((v) => parseInt(v, 16) / 255);
  const mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2;
  let h = 0, s = 0;
  if (mx !== mn) {
    const dd = mx - mn;
    s = l > 0.5 ? dd / (2 - mx - mn) : dd / (mx + mn);
    if (mx === r) h = ((g - b) / dd + (g < b ? 6 : 0)) * 60;
    else if (mx === g) h = ((b - r) / dd + 2) * 60;
    else h = ((r - g) / dd + 4) * 60;
  }
  return { h, s, l };
}
const neutral = (hex) => {
  const c = hsl(hex);
  return c.s < 0.17 || c.l < 0.13 || c.l > 0.93;
};
const hueGap = (a, b) => {
  const d = Math.abs(a - b) % 360;
  return d > 180 ? 360 - d : d;
};

const WARM_WORDS = { wolle: 1.4, kaschmir: 1.4, fleece: 1.3, daune: 2, strick: 1, leder: 0.6, denim: 0.4, baumwolle: 0, jersey: 0, leinen: -0.6, seide: -0.4 };
const FORMAL_HINTS = [
  { re: /(anzug|blazer|sakko|hemd|bluse|loafer|oxford|derby|mantel|rock|kleid|krawatte)/i, v: 4.4 },
  { re: /(chino|strick|pullover|cardigan|polo|chelsea|stiefel|hemdjacke|overshirt|trench)/i, v: 3.3 },
  { re: /(jeans|denim|sneaker|t-shirt|shirt|hoodie|sweat|cargo|parka|bomber|kapuze|beanie|mütze)/i, v: 2 },
  { re: /(jogging|trainings|sport|lauf|shorts|flip|slide)/i, v: 1.2 },
];

function derive(a) {
  const th = Math.max(0, THICKNESS.indexOf(a.thickness));
  const mat = String(a.material || "").toLowerCase();
  let bonus = 0;
  Object.keys(WARM_WORDS).forEach((k) => {
    if (mat.includes(k)) bonus = WARM_WORDS[k];
  });
  let warmth;
  if (a.category === "Jacke") warmth = 2.2 + th * 1.4 + bonus;
  else if (a.category === "Oberteil") warmth = 0.9 + th * 1.1 + bonus + (a.sleeve === "lang" ? 0.5 : 0);
  else if (a.category === "Unterteil") warmth = 1.2 + th * 0.9 + bonus + (a.length === "shorts" ? -1 : 0);
  else if (a.category === "Kleid") warmth = 1 + th * 1 + bonus;
  else if (a.category === "Schuhe") warmth = 1 + th * 0.6;
  else warmth = HEAD_WARM.includes(a.subcategory) ? 1.5 + th * 0.5 : 0.4;

  const hay = `${a.subcategory || ""} ${a.name || ""} ${mat}`;
  let formality = 2.6;
  for (const f of FORMAL_HINTS) if (f.re.test(hay)) { formality = f.v; break; }
  if (a.pattern === "logo") formality -= 0.7;
  if (a.texture === "glänzend") formality += 0.4;
  if (a.fit === "oversize") formality -= 0.4;

  return {
    warmth: Math.max(0.4, Math.min(5, Math.round(warmth * 2) / 2)),
    formality: Math.max(1, Math.min(5, Math.round(formality * 2) / 2)),
  };
}

/* ──────────────────────── Regeln, hart und weich ─────────────────── */

const VOL = { oversize: 3, weit: 2.5, regular: 2, cropped: 2, slim: 1 };
const vol = (i) => VOL[i.fit] ?? 2;
const isAcc = (p) => p.category === "Accessoire";

function sSilhouette(top, bottom, mode) {
  const vt = vol(top), vb = vol(bottom);
  if (mode === "offen") return Math.abs(vt - vb) >= 1 ? 0.9 : 0.85;
  if (mode === "oversize") {
    if (vt <= 1 || vb <= 1) return 0;
    if (vt >= 2.5 && vb >= 2.5) return 1;
    return vt >= 2.5 || vb >= 2.5 ? 0.6 : 0.32;
  }
  if (mode === "mix") {
    if (vb <= 1) return 0;
    if (vt >= 2.5 && vb === 2) return 1;
    return vt >= 2.5 ? 0.6 : 0.38;
  }
  const diff = Math.abs(vt - vb);
  return diff >= 1 ? 0.96 : vt >= 2.5 ? 0.72 : 0.78;
}

function sProportion(top, bottom, body) {
  const tl = top.length || "hüftlang";
  const bl = bottom.length || "lang";
  const rise = bottom.rise || "mid";
  let s = 0.8;
  if (tl === "cropped") s = rise === "high" ? 1 : rise === "mid" ? 0.74 : 0.32;
  if (tl === "hüftlang") s = rise === "low" ? 0.58 : 0.86;
  if (tl === "longline") s = bl === "shorts" ? 0.28 : vol(bottom) >= 2.5 ? 0.7 : 0.92;
  if (bl === "stacked" && vol(bottom) <= 1) s *= 0.72;

  let m = 1;
  const h = body?.height || 180;
  if (h <= 172) {
    if (tl === "longline" && vol(bottom) >= 2.5) m *= 0.72;
    if (tl === "cropped" && rise === "high") m *= 1.14;
    if (rise === "low") m *= 0.84;
  }
  if (h >= 188 && tl === "longline") m *= 1.06;
  if (body?.build === "kräftig") {
    if (vol(top) >= 2.5 && vol(bottom) >= 2.5) m *= 0.84;
    if (vol(top) >= 2.5 && vol(bottom) === 2) m *= 1.08;
  }
  if (body?.build === "schlank" && vol(top) >= 2.5 && vol(bottom) >= 2.5) m *= 1.05;
  if (body?.torso === "langer Oberkörper") m *= rise === "high" ? 1.12 : rise === "low" ? 0.76 : 1;
  if (body?.torso === "lange Beine") m *= tl === "longline" ? 1.08 : tl === "cropped" ? 0.92 : 1;

  return Math.max(0, Math.min(1, s * m));
}

function colorDetail(parts) {
  const hexes = parts.map((p) => p.colorHex).filter(Boolean);
  const colored = hexes.filter((h) => !neutral(h));
  let worst = 1;
  if (colored.length > 1)
    for (let i = 0; i < colored.length; i++)
      for (let j = i + 1; j < colored.length; j++) {
        const gap = hueGap(hsl(colored[i]).h, hsl(colored[j]).h);
        worst = Math.min(worst, gap < 18 ? 0.96 : gap < 50 ? 0.9 : gap > 150 ? 0.74 : gap > 100 ? 0.44 : 0.3);
      }
  let base = colored.length > 1 ? (colored.length >= 3 ? worst * 0.84 : worst) : 0.92;
  const ls = hexes.map((h) => hsl(h).l);
  const spread = Math.max(...ls) - Math.min(...ls);
  if (spread < 0.07) base *= 0.88;
  if (spread > 0.55) base = Math.min(1, base * 1.05);
  return { score: base, worst };
}

const boldCount = (parts) => parts.filter((p) => p.pattern && p.pattern !== "uni" && (p.patternScale === "groß" || p.pattern === "kariert")).length;

function sPattern(parts) {
  const bold = boldCount(parts);
  const any = parts.filter((p) => p.pattern && p.pattern !== "uni").length;
  if (bold > 1) return 0.12;
  if (bold === 1 && any > 2) return 0.48;
  return any === 0 ? 0.84 : 1;
}

function sTexture(parts) {
  const t = parts.map((p) => p.texture).filter(Boolean);
  if (t.length < 2) return 0.85;
  const u = new Set(t).size;
  return u === 1 ? 0.74 : u >= 3 ? 0.88 : 1;
}

function sShoes(shoe, bottom) {
  const w = shoe.shoeWeight || "normal";
  const v = vol(bottom);
  if (v >= 2.5) return w === "chunky" ? 1 : w === "normal" ? 0.82 : 0.42;
  if (v <= 1) return w === "chunky" ? 0.62 : 0.92;
  return 0.9;
}

function sFormality(parts, target) {
  const v = parts.filter((p) => !isAcc(p)).map((p) => p.formality || 3);
  const spread = Math.max(...v) - Math.min(...v);
  const mean = v.reduce((a, b) => a + b, 0) / v.length;
  return (spread <= 1 ? 1 : spread <= 2 ? 0.56 : 0.16) * 0.55 + Math.max(0, 1 - Math.abs(mean - target) / 2.5) * 0.45;
}

const need = (t) => (t >= 25 ? 3 : t >= 18 ? 5 : t >= 12 ? 7 : t >= 5 ? 9 : 11.5);
const warmthSum = (parts) => parts.filter((p) => !isAcc(p) || HEAD_WARM.includes(p.subcategory)).reduce((a, p) => a + (p.warmth || 3), 0);
const sWarmth = (parts, t) => Math.max(0, 1 - Math.abs(warmthSum(parts) - need(t)) / 5.5);

const sFresh = (parts) =>
  Math.min(
    ...parts.map((p) => {
      if (!p.lastWorn) return 1;
      const d = (Date.now() - new Date(p.lastWorn).getTime()) / 86400000;
      return d < 2 ? 0.12 : d < 5 ? 0.58 : d < 10 ? 0.88 : 1;
    })
  );

const pairKey = (a, b) => [a, b].sort().join("|");
function fbFactor(parts, fb) {
  let f = 1;
  for (let i = 0; i < parts.length; i++)
    for (let j = i + 1; j < parts.length; j++) {
      const k = pairKey(parts[i].id, parts[j].id);
      if (fb.disliked.includes(k)) f *= 0.3;
      else if (fb.liked.includes(k)) f *= 1.12;
    }
  return Math.min(f, 1.4);
}

const W = { silhouette: 0.23, proportion: 0.15, color: 0.16, warmth: 0.15, formality: 0.12, shoes: 0.09, pattern: 0.06, texture: 0.04 };
/* Ohne Silhouettenvorgabe trägt die Passung zur Statur das Gewicht. */
const W_OPEN = { silhouette: 0.08, proportion: 0.30, color: 0.16, warmth: 0.15, formality: 0.12, shoes: 0.09, pattern: 0.06, texture: 0.04 };

/* Harte Ausschlüsse. Was hier scheitert, wird nie vorgeschlagen. */
function violates(parts, ctx, level) {
  const top = parts.find((p) => p.category === "Oberteil" || p.category === "Kleid");
  const bottom = parts.find((p) => p.category === "Unterteil");
  const shoe = parts.find((p) => p.category === "Schuhe");
  const tol = level === 0 ? 1 : level === 1 ? 1.35 : 1.8;

  if (top && bottom && sSilhouette(top, bottom, ctx.mode) === 0) return "Silhouette";
  if (ctx.mode === "offen" && top && bottom && sProportion(top, bottom, ctx.body) < 0.42 / tol) return "passt nicht zur Statur";
  if (boldCount(parts) > 1) return "zwei laute Muster";
  const f = parts.filter((p) => !isAcc(p)).map((p) => p.formality || 3);
  if (Math.max(...f) - Math.min(...f) > 2 * tol) return "Formalität";
  if (Math.abs(warmthSum(parts) - need(ctx.temp)) > 4.5 * tol) return "Wetter";
  if (colorDetail(parts).worst < 0.34 / tol) return "Farbkonflikt";
  if (shoe && bottom && sShoes(shoe, bottom) < 0.45 / tol) return "Schuhgewicht";
  return null;
}

function score(parts, ctx) {
  const top = parts.find((p) => p.category === "Oberteil" || p.category === "Kleid");
  const bottom = parts.find((p) => p.category === "Unterteil");
  const shoe = parts.find((p) => p.category === "Schuhe");
  const sub = {
    silhouette: top && bottom ? sSilhouette(top, bottom, ctx.mode) : 0.82,
    proportion: top && bottom ? sProportion(top, bottom, ctx.body) : 0.85,
    color: colorDetail(parts).score,
    warmth: sWarmth(parts, ctx.temp),
    formality: sFormality(parts, ctx.target),
    shoes: shoe && bottom ? sShoes(shoe, bottom) : 0.85,
    pattern: sPattern(parts),
    texture: sTexture(parts),
  };
  const weights = ctx.mode === "offen" ? W_OPEN : W;
  let total = Object.keys(weights).reduce((a, k) => a + weights[k] * sub[k], 0);
  if (parts.some(isAcc)) total += 0.02;
  total *= fbFactor(parts, ctx.fb) * (0.9 + 0.1 * sFresh(parts));
  return { total: Math.min(total, 1), sub };
}

/* Erzeugt alle zulässigen Kombinationen, absteigend bewertet. */
function build(items, ctx, level = 0) {
  const by = (c) => items.filter((i) => i.category === c && !i.paused);
  const tops = by("Oberteil"), bottoms = by("Unterteil"), dresses = by("Kleid");
  const shoes = by("Schuhe"), outers = by("Jacke"), accs = by("Accessoire");
  const needOuter = ctx.temp < 14;
  const out = [];

  const finish = (base) => {
    if (!shoes.length) return;
    let best = null;
    shoes.forEach((sh) => {
      (needOuter && outers.length ? outers : [null]).forEach((ou) => {
        const core = ou ? [...base, sh, ou] : [...base, sh];
        let parts = core;
        if (accs.length) {
          let bestAcc = null;
          accs.forEach((ac) => {
            if (ctx.temp > 10 && HEAD_WARM.includes(ac.subcategory)) return;
            const cand = [...core, ac];
            if (violates(cand, ctx, level)) return;
            const s = score(cand, ctx).total;
            if (!bestAcc || s > bestAcc.s) bestAcc = { s, cand };
          });
          if (bestAcc && bestAcc.s > score(core, ctx).total) parts = bestAcc.cand;
        }
        if (ctx.anchor && !parts.some((p) => p.id === ctx.anchor)) return;
        if (violates(parts, ctx, level)) return;
        const sc = score(parts, ctx);
        if (!best || sc.total > best.score.total) best = { parts, score: sc };
      });
    });
    if (best) out.push(best);
  };

  tops.forEach((t) => bottoms.forEach((b) => finish([t, b])));
  dresses.forEach((d) => finish([d]));
  out.sort((a, b) => b.score.total - a.score.total);
  return out;
}

function topPicks(items, ctx) {
  let level = 0;
  let all = build(items, ctx, 0);
  while (all.length < 3 && level < 2) {
    level++;
    all = build(items, ctx, level);
  }
  const picked = [];
  const seen = {};
  for (const r of all) {
    const k = r.parts[0].id;
    if (seen[k]) continue;
    seen[k] = 1;
    picked.push(r);
    if (picked.length >= 8) break;
  }
  return { picks: picked, relaxed: level > 0, total: all.length };
}

/* ─────────────────── Lückenanalyse mit virtuellem Test ───────────── */

function catalogFor(gender) {
  const base = [
    { name: "weite Hose, schwarz, hoher Bund", category: "Unterteil", fit: "weit", length: "lang", rise: "high", colorHex: "#1b1b1b", thickness: "mittel", material: "baumwolle", pattern: "uni", texture: "glatt", preisklasse: "mittel" },
    { name: "gerade Jeans, mittelblau", category: "Unterteil", fit: "regular", length: "knöchel", rise: "mid", colorHex: "#3f5878", thickness: "mittel", material: "denim", pattern: "uni", texture: "robust", preisklasse: "mittel" },
    { name: "Oversize T-Shirt, weiß", category: "Oberteil", fit: "oversize", length: "hüftlang", colorHex: "#f2f0ec", thickness: "mittel", material: "baumwolle", pattern: "uni", texture: "glatt", sleeve: "kurz", preisklasse: "budget" },
    { name: "Overshirt, sand", category: "Jacke", fit: "oversize", length: "hüftlang", colorHex: "#b9a894", thickness: "mittel", material: "baumwolle", pattern: "uni", texture: "strukturiert", sleeve: "lang", preisklasse: "mittel" },
    { name: "Strickpullover, dunkelgrau", category: "Oberteil", fit: "weit", length: "hüftlang", colorHex: "#494c50", thickness: "dick", material: "wolle", pattern: "uni", texture: "strukturiert", sleeve: "lang", preisklasse: "mittel" },
    { name: "Sneaker, weiß", category: "Schuhe", fit: "regular", colorHex: "#eeeae4", thickness: "mittel", material: "leder", pattern: "uni", texture: "glatt", shoeWeight: "normal", preisklasse: "mittel" },
    { name: "Boot, schwarz, grobe Sohle", category: "Schuhe", fit: "regular", colorHex: "#141414", thickness: "dick", material: "leder", pattern: "uni", texture: "robust", shoeWeight: "chunky", preisklasse: "premium" },
    { name: "Parka, oliv", category: "Jacke", fit: "oversize", length: "longline", colorHex: "#4a4f3a", thickness: "dick", material: "baumwolle", pattern: "uni", texture: "robust", sleeve: "lang", preisklasse: "premium" },
    { name: "Mütze, schwarz", category: "Accessoire", subcategory: "Mütze", fit: "regular", colorHex: "#191919", thickness: "mittel", material: "wolle", pattern: "uni", texture: "strukturiert", preisklasse: "budget" },
    { name: "Uhr, silber", category: "Accessoire", subcategory: "Uhr", fit: "regular", colorHex: "#b8bcc0", thickness: "dünn", material: "stahl", pattern: "uni", texture: "glänzend", preisklasse: "premium" },
    { name: "Tasche, schwarz", category: "Accessoire", subcategory: "Tasche", fit: "regular", colorHex: "#161616", thickness: "mittel", material: "nylon", pattern: "uni", texture: "glatt", preisklasse: "mittel" },
  ];
  const male = [
    { name: "Hemd, weiß, weit", category: "Oberteil", fit: "oversize", length: "hüftlang", colorHex: "#f4f2ee", thickness: "dünn", material: "baumwolle", pattern: "uni", texture: "glatt", sleeve: "lang", preisklasse: "mittel" },
    { name: "Cargohose, dunkelgrün", category: "Unterteil", fit: "weit", length: "stacked", rise: "mid", colorHex: "#3c443a", thickness: "mittel", material: "baumwolle", pattern: "uni", texture: "robust", preisklasse: "mittel" },
    { name: "Hoodie, grau meliert", category: "Oberteil", fit: "oversize", length: "hüftlang", colorHex: "#8a8d90", thickness: "dick", material: "baumwolle", pattern: "meliert", texture: "flauschig", sleeve: "lang", preisklasse: "mittel" },
  ];
  const female = [
    { name: "Oversize Hemd, weiß", category: "Oberteil", fit: "oversize", length: "longline", colorHex: "#f4f2ee", thickness: "dünn", material: "baumwolle", pattern: "uni", texture: "glatt", sleeve: "lang", preisklasse: "mittel" },
    { name: "Feinstrick, creme", category: "Oberteil", fit: "regular", length: "cropped", colorHex: "#e3dbcd", thickness: "mittel", material: "wolle", pattern: "uni", texture: "strukturiert", sleeve: "lang", preisklasse: "mittel" },
    { name: "Anzughose, schwarz, weit", category: "Unterteil", fit: "weit", length: "lang", rise: "high", colorHex: "#1a1a1a", thickness: "mittel", material: "wolle", pattern: "uni", texture: "glatt", preisklasse: "premium" },
    { name: "Loafer, schwarz", category: "Schuhe", fit: "regular", colorHex: "#151515", thickness: "mittel", material: "leder", pattern: "uni", texture: "glänzend", shoeWeight: "normal", preisklasse: "premium" },
  ];
  return [...base, ...(gender === "weiblich" ? female : male)];
}

const GOOD = 0.62;

function analyseGaps(items, ctx) {
  const real = items.filter((i) => !i.paused);
  const baseline = build(real, ctx, 0);
  const bestFor = {};
  baseline.forEach((o) => o.parts.forEach((p) => { bestFor[p.id] = Math.max(bestFor[p.id] || 0, o.score.total); }));

  const orphans = real
    .filter((i) => ["Oberteil", "Unterteil", "Kleid", "Schuhe"].includes(i.category))
    .filter((i) => (bestFor[i.id] || 0) < 0.55)
    .map((i) => ({ name: i.name, art: i.subcategory, schnitt: i.fit, farbe: i.colorName, bestePunkte: Math.round((bestFor[i.id] || 0) * 100) }));

  const candidates = catalogFor(ctx.gender).map((c, n) => {
    const virt = { ...c, ...derive(c), id: `virt_${n}` };
    const withIt = build([...real, virt], ctx, 0);
    const gain = withIt.filter((o) => o.score.total >= GOOD && o.parts.some((p) => p.id === virt.id)).length;
    const bestScore = Math.max(0, ...withIt.filter((o) => o.parts.some((p) => p.id === virt.id)).map((o) => o.score.total));
    return { teil: c.name, kategorie: c.category, preisklasse: c.preisklasse, neueOutfits: gain, bestePunkte: Math.round(bestScore * 100) };
  });

  candidates.sort((a, b) => b.neueOutfits - a.neueOutfits || b.bestePunkte - a.bestePunkte);

  const counts = {};
  CATEGORIES.forEach((c) => { counts[c] = real.filter((i) => i.category === c).length; });
  const accTypes = Array.from(new Set(real.filter(isAcc).map((i) => i.subcategory).filter(Boolean)));
  const guteOutfits = baseline.filter((o) => o.score.total >= GOOD).length;

  return { bestand: counts, accessoires: accTypes, guteOutfits, waisen: orphans.slice(0, 6), kandidaten: candidates.slice(0, 8) };
}

/* ──────────────────────────── Modellzugriff ──────────────────────── */

function extractJson(text) {
  const s = text.indexOf("{");
  const e = text.lastIndexOf("}");
  if (s < 0 || e < 0) throw new Error("kein json");
  return JSON.parse(text.slice(s, e + 1));
}

async function ask(content, { maxTokens = 1200, search = false } = {}) {
  const body = { model: "claude-sonnet-4-6", max_tokens: maxTokens, messages: [{ role: "user", content }] };
  if (search) body.tools = [{ type: "web_search_20250305", name: "web_search" }];
  const r = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  if (!r.ok) throw new Error("api");
  const data = await r.json();
  const text = data.content.filter((b) => b.type === "text").map((b) => b.text).join("\n");
  return extractJson(text);
}


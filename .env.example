# ============================================================
# Unraid Arr Stack — Environment-Konfiguration
# ============================================================
# Kopieren und ausfüllen:
#   cp .env.example .env
# .env ist gitignored — Secrets bleiben lokal auf dem Server.

# ============================================================
# GENERAL
# ============================================================
# Unraid-Default: PUID=99 (nobody), PGID=100 (users) — prüfen mit: id $USER
PUID=99
PGID=100

# Zeitzone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Berlin

# Basis-Pfad für Container-Configs (Unraid: /mnt/user/appdata)
APPDATA=/mnt/user/appdata

# Gemeinsamer Daten-Share — Medien UND Downloads unter einem Mount,
# damit Hardlinks/atomic moves funktionieren (TRaSH-Layout)
DATA=/mnt/user/data

# LAN-IP des Unraid-Servers
UNRAID_IP=192.168.1.100

# ============================================================
# TAILSCALE
# ============================================================
# Hostname in der Tailscale-Admin-Konsole
TS_HOSTNAME=arr-stack

# Pre-Auth-Key (https://login.tailscale.com/admin/settings/keys)
# WICHTIG: den VOLLSTÄNDIGEN Key kopieren — Format: tskey-auth-…-…
# Leer lassen für interaktives Login (URL via: docker logs tailscale)
TS_AUTHKEY=

# Extra-Flags für den Tailscale-Daemon (z. B. --ssh)
TS_EXTRA_ARGS=

# ============================================================
# USENET-PROVIDER (für SABnzbd, per Bootstrap gesetzt)
# ============================================================
EWEKA_HOST=news.eweka.nl
EWEKA_PORT=563
EWEKA_SSL=1
EWEKA_USERNAME=your_eweka_username
EWEKA_PASSWORD=your_eweka_password
EWEKA_CONNECTIONS=45

# ============================================================
# INDEXER (für Prowlarr, per Bootstrap gesetzt)
# ============================================================
SCENENZBS_URL=https://scenenzbs.com/
SCENENZBS_APIKEY=your_scenenzbs_apikey

# ============================================================
# PORTS (Host-Ports; Container-Ports bleiben fix)
# ============================================================
SABNZBD_PORT=8090
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
SEERR_PORT=5055
JELLYFIN_PORT_HTTP=8096
JELLYFIN_PORT_HTTPS=8920
HOMEPAGE_PORT=3000

ADGUARD_SETUP_PORT=3001
ADGUARD_WEBUI_PORT=8081

# Deaktivierte Dienste (Compose-Profile)
VAULTWARDEN_PORT=8082
THREADFIN_PORT=34400
LIDARR_PORT=8686
READARR_PORT=8787

# ============================================================
# ADGUARD HOME — lokaler DNS + Werbeblocker
# ============================================================
# Login für die AdGuard-Web-UI (wird vom Bootstrap gesetzt)
ADGUARD_USER=admin
ADGUARD_PASSWORD=change_me

# Dienst-Domain für die AdGuard-Rewrites: jellyfin.home → UNRAID_IP usw.
# Bewusst NICHT die Router-Domain (fritz.box), damit die Fritz!Box als
# DNS-Vermittler die Anfragen an AdGuard weiterreichen kann (sie beantwortet
# ihre eigene .fritz.box-Zone selbst und würde sie nicht weiterleiten).
# → Fritz!Box: diese Domain vom DNS-Rebind-Schutz ausnehmen (siehe DIENSTE.md).
LOCAL_DOMAIN=home

# Router-IP: Reverse-DNS (PTR) wird dorthin weitergeleitet; im Vermittler-
# Modell ist der Router zugleich der DNS-Server der Clients (siehe DIENSTE.md).
ROUTER_IP=192.168.1.1

# Eigene Domain des Routers (Fritz!Box: fritz.box) — nur für Reverse-DNS/PTR.
ROUTER_DOMAIN=fritz.box

# ============================================================
# HOMEPAGE
# ============================================================
# Erlaubte Hostnamen für das Dashboard („*“ = alle; einschränken möglich,
# z. B. auf „192.168.1.100:3000,arr-stack.tailnet-name.ts.net:3000“)
HOMEPAGE_ALLOWED_HOSTS=*

# Jellyfin-API-Key für das Homepage-Jellyfin-Widget (optional).
# In Jellyfin erzeugen: Dashboard → Erweitert → API-Schlüssel → +.
# Leer lassen = Homepage zeigt nur einen Erreichbarkeits-Punkt statt Statistiken.
JELLYFIN_API_KEY=

# ============================================================
# VAULTWARDEN (läuft dauerhaft mit — kein Profil mehr)
# ============================================================
# Das Admin-Token steht NICHT hier, sondern als Argon2id-Hash in der Datei
# ${APPDATA}/vaultwarden/admin_token (chmod 600, ADMIN_TOKEN_FILE im Compose).
# Grund: der Hash steckt voller `$`, und bootstrap/lib.sh liest die .env per
# `source` — dort würde er zerschossen. Neu setzen (fragt nach dem Passwort):
#   bash scripts/vaultwarden-admin-token.sh
#
# Registrierung standardmäßig zu; der eigene Account wird per Einladung im
# Admin-Panel angelegt. Eingeladene dürfen sich trotz false registrieren.
VW_SIGNUPS_ALLOWED=false
VW_INVITATIONS_ALLOWED=true

# Vollständige URL inkl. Protokoll (Pflichtformat!) — muss exakt der Adresse
# entsprechen, unter der die Clients den Server sehen, sonst brechen WebAuthn
# und die Push-Kanäle. Leer = Fallback auf http://<UNRAID_IP>:<VAULTWARDEN_PORT>
VW_DOMAIN=https://vault.mmaeurer.de

# Brute-Force-Bremse in Vaultwarden selbst (fail2ban kommt in SWAG obendrauf).
VW_LOGIN_RATELIMIT_SECONDS=60
VW_LOGIN_RATELIMIT_MAX_BURST=10
VW_ADMIN_RATELIMIT_SECONDS=300
VW_ADMIN_RATELIMIT_MAX_BURST=3

# ============================================================
# LIVE TV / IPTV (Profil „iptv“ — Threadfin hinter Premiumize-VPN)
# ============================================================
# NUR der Threadfin-Traffic läuft durch dieses VPN (gluetun-Split-Tunnel),
# der restliche Stack bleibt auf der normalen Leitung.
#
# 1. Auf premiumize.me/plugins die OpenVPN-Config herunterladen und als
#    ${APPDATA}/gluetun/premiumize.ovpn auf dem Server ablegen.
# 2. VPN-Zugangsdaten (Premiumize „Customer ID" + „PIN"/Passwort) hier eintragen:
PREMIUMIZE_VPN_USER=your_premiumize_vpn_user
PREMIUMIZE_VPN_PASSWORD=your_premiumize_vpn_password

# Subnetz des arr_net (docker network inspect arr_net) — damit Jellyfin den
# Threadfin-Port erreichen kann, ohne durchs VPN zu müssen. Standard passt meist.
ARR_NET_SUBNET=172.18.0.0/16

# ============================================================
# TORRENT (Profil „torrent“ — qBittorrent hinter demselben VPN)
# ============================================================
# qBittorrent-WebUI (läuft im gluetun-Netz-Stack, aller Traffic durchs VPN).
# Aus arr_net/Sonarr erreichbar als http://gluetun:8080, im Browser über
# diesen Host-Port. Erst-Setup + Sonarr-Verdrahtung: bootstrap/12-torrent.sh
QBIT_PORT=8085

# LAN-Subnetz (für den qBittorrent-WebUI-Auth-Bypass im Heimnetz).
# Anpassen, falls dein Netz nicht 192.168.178.0/24 ist.
LAN_SUBNET=192.168.178.0/24

# ============================================================
# DNS FÜR DIE CONTAINER
# ============================================================
# Warum fest eingetragen: Unraid startet die Container beim Booten, bevor der
# DHCP-Client /etc/resolv.conf geschrieben hat. Docker liest die Datei beim
# Erzeugen des Containers, findet nichts und schreibt „NO EXTERNAL NAMESERVERS
# DEFINED" hinein — danach löst kein Container mehr auf und alle Indexer fallen
# aus (beobachtet 11.08.2026: Container 18:58:48, resolv.conf 18:58:51).
#
# DOCKER_DNS zeigt auf die Fritz!Box, damit die .home-Namen aus AdGuard weiter
# funktionieren; der Fallback greift, falls Router oder AdGuard nicht antworten.
# Container-Namen (http://radarr:7878) löst weiterhin Dockers eigener Resolver
# unter 127.0.0.11 auf — der bleibt immer der erste Eintrag.
DOCKER_DNS=192.168.178.1
DOCKER_DNS_FALLBACK=9.9.9.9

# AdGuard selbst braucht öffentliche Resolver: die Fritz!Box forwardet .home
# an AdGuard zurück, das gäbe eine Auflösungsschleife.
ADGUARD_UPSTREAM_DNS=9.9.9.9
ADGUARD_UPSTREAM_DNS2=1.1.1.1

# Seeding-Grenzen. Ist eine davon erreicht, pausiert qBittorrent den Torrent;
# entfernt wird er dann von Sonarr (removeCompletedDownloads). Hintergrund:
# ein ewig seedender Torrent blockiert seine Datei im Download-Ordner, und der
# Unraid-Mover zerreißt dabei früher oder später den Hardlink zur Bibliothek —
# aus einer Datei werden zwei. Siehe bootstrap/12-torrent.sh.
QBIT_MAX_RATIO=2.0
QBIT_MAX_SEED_DAYS=7

# Interface, an das die BitTorrent-Session gebunden wird. tun0 ist das
# Tunnel-Interface in gluetun — damit kann qBittorrent gar nicht erst am VPN
# vorbei senden, statt sich allein auf den Killswitch zu verlassen.
QBIT_BIND_INTERFACE=tun0

# ---------------------------------------------------------------------------
# SWAG — Reverse Proxy (einziger Weg von außen, TCP/UDP 443)
# ---------------------------------------------------------------------------
# Nach außen erreichbar: tv.<SWAG_URL> (Jellyfin), seer.<SWAG_URL> (Seerr).
# Unraid-WebGUI, SSH und der arr-Stack bleiben ausschließlich über Tailscale
# erreichbar und bekommen bewusst keine proxy-conf.
SWAG_URL=mmaeurer.de
SWAG_EMAIL=                     # Kontaktadresse für Let's-Encrypt-Ablaufwarnungen
SWAG_PORT_HTTPS=443

# Erst gegen die Staging-CA testen (5 Fehlversuche/Stunde bei der echten CA).
# Nach erfolgreichem Testlauf: auf false setzen, /config/etc/letsencrypt
# löschen, Container neu starten.
SWAG_STAGING=true

# Zugangsdaten für die DNS-01-Challenge stehen NICHT hier, sondern in
# ${APPDATA}/swag/dns-conf/inwx.ini (chmod 600, nicht im Repo).
